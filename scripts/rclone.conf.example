# Install as ~/.config/geoimagenet/rclone.conf on the administrator's workstation (mode 600).
# Never commit the real file. Placeholders only.

[localcrypt]
type = crypt
# Directory that holds the encrypted backups (or a path on an external disk). The scripts mount it
# in the rclone container at the same path, so the same value works inside and outside.
remote = /home/<you>/geoimagenet-backups
filename_encryption = standard
directory_name_encryption = true
# Output of: read -rs P; printf %s "$P" | docker run --rm -i <pinned rclone image> obscure -
# (obscure is reversible: whoever reads this file can decrypt the backups). The plain password lives
# in the administrator's password manager. Without it no restore is possible.
password = <obscured crypt password>
# Optional but recommended, a salt: password2 = <obscured salt password>  (also in the password manager)

# Future option, currently unused (scripts/offsite-backup.sh without --dump-only): upload from the VM to Swift.
# Arbutus' Ceph RGW answers 401 to application credentials restricted by access rules.
# [swift]
# type = swift
# auth = https://identity.arbutus.alliancecan.ca/v3
# application_credential_id = <id>
# application_credential_secret = <secret>
# region = RegionOne
# [swiftcrypt]
# type = crypt
# remote = swift:geoimagenet-backups
# filename_encryption = standard
# directory_name_encryption = true
# password = <obscured crypt password>
