# Local override. The api and frontend images come from GHCR (see the commented block below for local builds).
# Copy to docker-compose.override.yml (gitignored) and adjust.
# See ../DEPLOYMENT_PLAN.md, section 5 (Phase 1) and section 10.

services:
  api:
    # dev: build: ../geoimagenet-api                # branch fix/build-2026
    # dev: image: geoimagenet-api:dev
    environment:
      # local only: self-signed certificate
      - GEOIMAGENET_API_MAGPIE_VERIFY_SSL=false

  # Local development: build the images from the sibling repos instead of pulling from GHCR.
  # Uncomment the "# dev:" lines (delete the "# dev: " prefix) INSIDE the existing keys (a second `api:` or `geoserver_setup:`
  # key would be a duplicate), then run `./geoimagenet-compose.sh build api`.
  # YAML anchors don't cross files, so every user of the api image sets it.
  # dev: migrations:
  # dev:   image: geoimagenet-api:dev
  # Frontend: build it by hand, then use it in frontend_files:
  #   docker build -t geoimagenet-frontend:dev ../geoimagenet-frontend
  # dev: frontend_files:
  # dev:   image: geoimagenet-frontend:dev

  geoserver:
    # local only: reach GeoServer directly at http://localhost:8600/geoserver, bypassing Twitcher
    ports:
      - "8600:8080"

  # Datastore GeoServer: serves the GeoTIFFs in /nas. The platform's `geoserver` (the
  # "mirror") cascades its layers over WMS. CRIM ran this on a separate server; locally
  # it is a second container. Set in env.local:
  #   GEOIMAGENET_API_GS_DATASTORE_URL=http://geoserver-datastore:8080/geoserver
  # Then: ./geoimagenet-compose.sh run --rm geoserver_setup --setup-datastore
  # The name must not contain an underscore: Tomcat rejects such Host headers with 400.
  geoserver-datastore:
    # same official image as `geoserver` (pinned by index digest, see docker-compose.yml)
    image: docker.osgeo.org/geoserver:3.0.2@sha256:5a372d4988116e8f62c71ae5ff6eb8d433967697670fb1dec15379bf476721fe
    container_name: geoserver-datastore
    environment:
      - SKIP_DEMO_DATA=true
      - GEOSERVER_ADMIN_USER=admin
      - GEOSERVER_ADMIN_PASSWORD=${GEOIMAGENET_API_GS_DATASTORE_PASSWORD:?set in env.local}
      - EXTRA_JAVA_OPTS=-Xms512M -Xmx2G -Dorg.geotools.referencing.forceXY=true -Duser.timezone=GMT
    volumes:
      # new directory: /data/geoserver_datastore (GeoServer 2.15) stays untouched as the rollback
      - /data/geoserver_datastore_3/data_dir:/opt/geoserver_data
      # same path as in geoserver_setup: stores are registered as file:/nas/...
      - /nas:/nas:ro
    restart: unless-stopped
    healthcheck:
      test: curl --fail -s -o /dev/null "$$(cat $$CATALINA_HOME/conf/healthcheck_url.txt)" || exit 1
      interval: 1m30s
      timeout: 10s
      retries: 3
      start_period: 3m
      start_interval: 10s

  geoserver_setup:
    # dev: image: geoimagenet-api:dev
    depends_on:
      geoserver-datastore:
        condition: service_healthy
